<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>SpeedEnglish</AssemblyName>
    <RootNamespace>SpeedEnglish</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Product>Speed English Hebrew</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\enheb.txt" />
    <EmbeddedResource Include="Assets\heb.txt" />
    <EmbeddedResource Include="Assets\ca1.mp3" />
    <Resource Include="Assets\ic_launcher.png" />
  </ItemGroup>

</Project>
