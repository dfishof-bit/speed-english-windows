<Window x:Class="SpeedEnglish.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speed English — לימוד אנגלית מהיר (אופליין)"
        Height="760"
        Width="780"
        MinHeight="640"
        MinWidth="560"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgSurface}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0"
                    Background="{StaticResource CardSurface}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/ic_launcher.png"
                               Width="40" Height="40" Margin="0,0,10,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Speed English" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource BrandPrimaryDark}" />
                            <TextBlock Text="50,010 מילים בעברית • 100% אופליין" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="NavGame" Content="משחק" Style="{StaticResource NavTabButtonStyle}" Click="NavTab_Click" Tag="game" />
                        <Button x:Name="NavLevels" Content="שלבים" Style="{StaticResource NavTabButtonStyle}" Click="NavTab_Click" Tag="levels" />
                        <Button x:Name="NavSettings" Content="הגדרות" Style="{StaticResource NavTabButtonStyle}" Click="NavTab_Click" Tag="settings" />
                        <Button x:Name="NavHelp" Content="עזרה" Style="{StaticResource NavTabButtonStyle}" Click="NavTab_Click" Tag="help" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- GAME PANEL -->
            <Grid x:Name="PanelGame" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Level & Streak Card -->
                <Border Grid.Row="0"
                        Background="{StaticResource CardSurface}"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="18,14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border DockPanel.Dock="Left" Background="{StaticResource BrandPrimarySoft}" CornerRadius="14" Padding="12,5">
                                <TextBlock x:Name="TxtLevelBadge" Text="שלב 1 • מאגר: 100 מילים" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryDark}" />
                            </Border>
                            <TextBlock x:Name="TxtStreak" DockPanel.Dock="Right" Text="רצף: 0 / 10" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ProgressBar x:Name="ProgressStreak" Height="10" Minimum="0" Maximum="10" Value="0" Foreground="{StaticResource BrandAccent}" Background="#E4EBF5" BorderThickness="0" />
                    </StackPanel>
                </Border>

                <!-- Word Card -->
                <Border Grid.Row="1"
                        Background="{StaticResource CardSurface}"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="24,26"
                        Margin="0,0,0,10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtEnglishWord"
                                   Text="..."
                                   FlowDirection="LeftToRight"
                                   FontSize="40"
                                   FontWeight="ExtraBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Center"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="TxtEnglishWord_MouseLeftButtonUp" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button x:Name="BtnSpeak" Content="🔊 השמע מילה" Style="{StaticResource PillButtonStyle}" Margin="0,0,8,0" Click="BtnSpeak_Click" />
                            <Button x:Name="BtnQuickMute" Content="🔈 הקראה אוטומטית: פעילה" Style="{StaticResource PillButtonStyle}" Click="BtnQuickMute_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Feedback -->
                <TextBlock x:Name="TxtFeedback"
                           Grid.Row="2"
                           Height="26"
                           TextAlignment="Center"
                           FontSize="15"
                           FontWeight="Bold"
                           Margin="0,2,0,8" />

                <!-- Answers -->
                <StackPanel x:Name="AnswersPanel" Grid.Row="3" VerticalAlignment="Center" />

                <!-- Keyboard hint -->
                <TextBlock Grid.Row="4"
                           Text="קיצורי מקלדת: מקשים 1–5 לבחירת תשובה • רווח (Space) או R להשמעה חוזרת"
                           TextAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,6,0,0" />
            </Grid>

            <!-- LEVELS PANEL -->
            <Border x:Name="PanelLevels"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="{StaticResource CardSurface}"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="בחירת שלב וגודל מאגר (1 עד 500)" FontSize="17" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryDark}" />
                            <TextBlock x:Name="TxtLevelsSummary" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="קפיצה לשלב:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondary}" />
                            <TextBox x:Name="TxtJumpLevel" Width="64" Padding="6,4" FontSize="14" VerticalContentAlignment="Center" />
                            <Button Content="עבור" Style="{StaticResource PillButtonStyle}" Margin="6,0,0,0" Click="BtnJumpLevel_Click" />
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel x:Name="RangeTabsPanel" Grid.Row="1" Margin="0,0,0,12" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <UniformGrid x:Name="LevelsGrid" Columns="5" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- SETTINGS PANEL -->
            <ScrollViewer x:Name="PanelSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Rules -->
                    <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="חוקי המשחק" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryDark}" Margin="0,0,0,12" />

                            <DockPanel Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="אורך רצף תשובות נכונות לעליית שלב" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="בסיום הרצף נוספות 100 מילים שכיחות למאגר" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="BtnStreak10" Content="10 ברצף" Style="{StaticResource NavTabButtonStyle}" Click="BtnStreak10_Click" />
                                    <Button x:Name="BtnStreak15" Content="15 ברצף" Style="{StaticResource NavTabButtonStyle}" Click="BtnStreak15_Click" />
                                </StackPanel>
                            </DockPanel>

                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="מספר אפשרויות תשובה בכל שאלה" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="ברירת מחדל: 5 תשובות (ניתן להחזיר ל-4 הקלאסי)" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="BtnChoices5" Content="5 תשובות" Style="{StaticResource NavTabButtonStyle}" Click="BtnChoices5_Click" />
                                    <Button x:Name="BtnChoices4" Content="4 תשובות" Style="{StaticResource NavTabButtonStyle}" Click="BtnChoices4_Click" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Speech & Audio -->
                    <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="הקראה קולית ושמע (Windows אופליין)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryDark}" Margin="0,0,0,12" />

                            <CheckBox x:Name="ChkTts" Content="הקראה אוטומטית של המילה באנגלית" FontSize="14" Margin="0,0,0,12" Checked="ChkTts_Changed" Unchecked="ChkTts_Changed" />

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Text="קול הקראה מותקן ב-Windows:" VerticalAlignment="Center" FontSize="14" />
                                <ComboBox x:Name="CmbVoices" DockPanel.Dock="Right" Width="280" SelectionChanged="CmbVoices_SelectionChanged" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock x:Name="TxtRateLabel" DockPanel.Dock="Left" Text="מהירות הקראה: 0" VerticalAlignment="Center" FontSize="14" />
                                <Slider x:Name="SliderRate" DockPanel.Dock="Right" Width="260" Minimum="-5" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderRate_ValueChanged" />
                            </DockPanel>

                            <CheckBox x:Name="ChkSound" Content="צליל חגיגי בעליית שלב (הצליל המקורי)" FontSize="14" Margin="0,0,0,14" Checked="ChkSound_Changed" Unchecked="ChkSound_Changed" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="🔊 בדיקת הקראה" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Click="BtnTestVoice_Click" />
                                <Button Content="איפוס הגדרות לברירת מחדל" Style="{StaticResource PillButtonStyle}" Click="BtnResetSettings_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Stats -->
                    <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="16" Padding="20">
                        <StackPanel>
                            <TextBlock Text="סטטיסטיקה ושמירה מקומית במחשב" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryDark}" Margin="0,0,0,12" />
                            <UniformGrid Columns="3" Margin="0,0,0,14">
                                <Border Background="#F7FAFF" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="StatHighest" Text="1" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource BrandPrimaryDark}" HorizontalAlignment="Center" />
                                        <TextBlock Text="שלב שיא" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#F7FAFF" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="StatCorrect" Text="0" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource BrandPrimaryDark}" HorizontalAlignment="Center" />
                                        <TextBlock Text="תשובות נכונות" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#F7FAFF" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="StatWrong" Text="0" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource BrandPrimaryDark}" HorizontalAlignment="Center" />
                                        <TextBlock Text="טעויות" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <Button Content="איפוס התקדמות לשלב 1" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Left" Click="BtnResetProgress_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- HELP PANEL -->
            <ScrollViewer x:Name="PanelHelp" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="16" Padding="24">
                    <StackPanel>
                        <TextBlock Text="איך עובדת Speed English?" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryDark}" Margin="0,0,0,12" />
                        <TextBlock TextWrapping="Wrap" FontSize="15" LineHeight="26" Foreground="{StaticResource TextPrimary}"
                                   Text="התוכנה מציגה שיטה מהירה ויעילה ללימוד אוצר מילים באנגלית על פי שכיחותן בשפה, מתוך מאגר מקומי מלא של 50,010 מילים." />
                        <TextBlock Text="מהלך המשחק:" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryDark}" Margin="0,16,0,6" />
                        <TextBlock TextWrapping="Wrap" FontSize="15" LineHeight="26" Foreground="{StaticResource TextPrimary}"
                                   Text="• מתחילים משלב 1 — מבחן אמריקאי מתוך 100 המילים השכיחות ביותר באנגלית.&#x0a;• בכל שלב יש לענות נכונה ברצף (ברירת מחדל: 10 מילים ברצף מתוך 5 תשובות). בסיום הרצף עולים שלב ונוספות עוד 100 מילים שכיחות.&#x0a;• במקרה של טעות, התשובה הנכונה מודגשת בירוק והרצף מתאפס.&#x0a;• במסך הגדרות ניתן לשנות בכל עת ל-15 ברצף או ל-4 תשובות, וכן לבחור קול ומהירות הקראה." />
                        <TextBlock Text="קיצורי מקלדת:" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryDark}" Margin="0,16,0,6" />
                        <TextBlock TextWrapping="Wrap" FontSize="15" LineHeight="26" Foreground="{StaticResource TextPrimary}"
                                   Text="• מקשים 1 עד 5 — בחירה מהירה של תשובה.&#x0a;• מקש רווח (Space) או R — השמעה חוזרת של המילה באנגלית.&#x0a;• מקש Enter — המשך מהיר לאחר עליית שלב." />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- LEVEL UP OVERLAY MODAL -->
        <Grid x:Name="LevelUpOverlay" Visibility="Collapsed" Background="#880F192D">
            <Border Background="White" CornerRadius="20" Padding="28" MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🏆" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="כל הכבוד!" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource BrandPrimaryDark}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock x:Name="TxtLevelUpMessage" TextWrapping="Wrap" TextAlignment="Center" FontSize="16" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,22" />
                    <Button Content="המשך לשלב הבא" Style="{StaticResource PrimaryButtonStyle}" Width="240" Click="BtnLevelUpContinue_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
